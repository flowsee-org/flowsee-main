APP_NAME=Flowsee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Studio integration
# Email of the primary Studio superadmin authorized to manage site content.
STUDIO_ADMIN_EMAIL=ceo@flowsee.local
# Base URL of the Studio app used to resolve the current Studio session.
STUDIO_BASE_URL=https://studio.flowsee.ir
# Comma-separated browser origins allowed to call the Studio API and embed the
# admin panel (local dev server and production).
STUDIO_ALLOWED_ORIGINS=https://studio.flowsee.ir,http://localhost:5173
